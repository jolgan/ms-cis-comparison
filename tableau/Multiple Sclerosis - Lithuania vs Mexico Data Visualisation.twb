      <aliases enabled='yes' />
      <column caption='Conversion Rate' datatype='real' name='[Calculation_2863726425382862848]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF [conversion_outcome] = 1 THEN 1 ELSE 0 END) / &#13;&#10;SUM(IF [conversion_outcome] = 0 OR [conversion_outcome] = 1 &#13;&#10;THEN 1 ELSE 0 END)' />
      </column>
      <column caption='OGB Positivity Rate' datatype='real' name='[Calculation_2863726425649410049]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF [oligoclonal_bands] = 1 THEN 1 ELSE 0 END) &#13;&#10;/ &#13;&#10;SUM(IF [oligoclonal_bands] = 0 &#13;&#10;OR &#13;&#10;[oligoclonal_bands] = 1 THEN 1 ELSE 0 END)' />
      </column>
      <column caption='Outcome Label' datatype='string' name='[Calculation_2863726425654374402]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [conversion_outcome] = 1 THEN &#13;&#10;&quot;Converter&quot; ELSE &quot;Non-Converter&quot; END' />
      </column>
      <column caption='Periventricular Lesion Presence' datatype='real' name='[Calculation_2863726425869574147]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF [periventricular_mri] = 1 THEN 1 ELSE 0 END)&#13;&#10;/&#13;&#10;SUM(IF [periventricular_mri] = 0 &#13;&#10;OR &#13;&#10;[periventricular_mri] = 1 THEN 1 ELSE 0 END)' />
      </column>
      <column caption='VEP Positivity Rate' datatype='real' name='[Calculation_2863726425897320452]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF [vep] = 1 THEN 1 ELSE 0 END)&#13;&#10;/&#13;&#10;SUM(IF [vep] = 0 OR [vep] = 1 THEN 1 ELSE 0 END)' />
      </column>
